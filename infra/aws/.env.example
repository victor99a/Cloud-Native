# Copiar a ".env" en infra/aws/ de CADA host (messaging y apps) y completar.

# IP PRIVADA de la EC2 "messaging" (Kafka + RabbitMQ).
MESSAGING_HOST=172.31.x.x
KAFKA_BOOTSTRAP_SERVERS=172.31.x.x:9092,172.31.x.x:9093,172.31.x.x:9094

DB_NAME=pedidos360
DB_USERNAME=postgres
DB_PASSWORD=cambiar-esta-clave

RABBITMQ_USERNAME=pedidos360
RABBITMQ_PASSWORD=cambiar-esta-clave
RABBITMQ_ERLANG_COOKIE=cambiar-esta-cookie

# Amazon Cognito (IDaaS): issuer del User Pool y Client ID de la SPA.
JWT_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
JWT_AUDIENCE=xxxxxxxxxxxxxxxxxxxxxxxxxx
