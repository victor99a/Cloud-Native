# Copiar a ".env" (en esta misma carpeta) y completar con los valores reales.
# docker-compose lee automáticamente el archivo ".env" de esta carpeta.

DB_NAME=pedidos360
DB_USERNAME=postgres
DB_PASSWORD=postgres

# RabbitMQ (clúster de 2 nodos: rabbitmq1 y rabbitmq2 comparten la cookie)
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_ERLANG_COOKIE=pedidos360-erlang-cookie

# Del tenant de Azure AD (App registration "Pedidos360" -> Exponer una API)
AZURE_ISSUER_URI=https://login.microsoftonline.com/<TENANT_ID>/v2.0
AZURE_AUDIENCE=api://<CLIENT_ID>
