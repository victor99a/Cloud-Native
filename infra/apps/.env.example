# Copiar a ".env" (en esta misma carpeta) y completar con los valores deseados.
# docker-compose lee automáticamente el archivo ".env" de esta carpeta.

DB_NAME=pedidos360
DB_USERNAME=postgres
DB_PASSWORD=postgres

# RabbitMQ (clúster de 2 nodos: rabbitmq1 y rabbitmq2 comparten la cookie)
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_ERLANG_COOKIE=pedidos360-erlang-cookie

# Keycloak (IDaaS local). Credenciales de bootstrap del admin console.
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Emisor y audiencia del JWT (deben coincidir con el realm/cliente importado).
# El issuer usa la URL que ve el navegador (localhost:8090); el JWKS usa la URL
# interna del contenedor (keycloak:8080).
KEYCLOAK_ISSUER_URI=http://localhost:8090/realms/pedidos360
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/pedidos360/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=pedidos360-spa
